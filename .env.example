# ---------------------------------------------------------
# KASIR — Environment Variables
# Salin file ini menjadi .env lalu isi nilainya.
# ---------------------------------------------------------

# Koneksi Neon PostgreSQL.
# Gunakan connection string dari Neon. Untuk aplikasi web Node.js,
# connection string "Pooled connection" direkomendasikan.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Wajib diganti. Minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter

# Server
NODE_ENV=development
PORT=4000

# Zona waktu untuk laporan & transaksi harian
STORE_TIMEZONE=Asia/Jakarta

# Jalankan migrasi database otomatis saat server mulai.
# Bisa dinonaktifkan setelah migrasi dijalankan manual (npm run db:migrate).
RUN_MIGRATIONS_ON_START=true

# Mode sinkronisasi realtime: auto | sse | polling.
# auto = SSE untuk server biasa, polling untuk Vercel/serverless.
REALTIME_MODE=auto

# Token Vercel Blob untuk upload gambar produk di Vercel.
# Biarkan kosong untuk penyimpanan lokal saat development.
# Jika Blob di-connect dengan prefix POS_, aplikasi juga membaca
# POS_BLOB_READ_WRITE_TOKEN sebagai cadangan.
BLOB_READ_WRITE_TOKEN=
